# Tout se règle aussi dans l'interface web (http://localhost:8080) : ce fichier est facultatif.
# Les réglages faits dans l'interface priment et sont gardés dans le volume bot-data.

OPENAI_API_KEY=

# Protéger l'interface par un jeton (recommandé si elle est exposée au-delà de localhost) :
# ouvrir ensuite http://hôte:8080/?token=<jeton>
FDM_UI_TOKEN=

# 1 = écran du bot visible en VNC sur localhost:5900
FDM_VNC=1
