# Clé API OpenAI (obligatoire)
OPENAI_API_KEY=sk-...

# Comment on l'appelle : prénom, puis surnoms / nom de famille / nom complet
FDM_AGENT_NAME=Nova
FDM_AGENT_ALIASES=Nov,Martin,Nova Martin

# live = gpt-live-1 (vraiment full duplex, défaut) ; realtime = gpt-realtime (tour par tour)
FDM_ENGINE=live
FDM_VOICE=marin
FDM_LANGUAGE=fr

# Rôle, ordre du jour, participants… (facultatif)
FDM_CONTEXT=

# --- Live ---
# name = sa voix n'atteint la réunion qu'une fois appelé par son nom ; off = le modèle juge seul
FDM_GATE=name
# Il se remet en retrait si les autres parlent entre eux ce temps-là sans s'adresser à lui (s).
# Ça ne limite JAMAIS la longueur de ses réponses.
FDM_DISENGAGE_SECONDS=90
# Qui réfléchit quand gpt-live-1 délègue : responses (modèle OpenAI + recherche web) ou client
FDM_DELEGATION=responses
FDM_BACKEND_MODEL=gpt-5.6-luna

# --- Realtime ---
FDM_REALTIME_MODEL=gpt-realtime
FDM_BARGE_IN_MS=400
