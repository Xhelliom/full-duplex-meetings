# Clé API OpenAI (obligatoire)
OPENAI_API_KEY=sk-...

# Modèle Realtime et voix
FDM_MODEL=gpt-realtime
FDM_VOICE=marin

# Nom affiché dans Teams + nom auquel l'agent réagit
FDM_AGENT_NAME=Assistant IA
# Autres façons dont on peut l'appeler (séparées par des virgules) – utile si la transcription déforme le nom
FDM_AGENT_ALIASES=assistant,l'assistant,IA

# Langue principale de la réunion (code ISO, sert à la transcription)
FDM_LANGUAGE=fr

# always = répond à chaque prise de parole ; name = seulement quand on l'interpelle (recommandé en réunion)
FDM_REPLY_MODE=name
# Après une réponse, l'agent continue à répondre sans être nommé pendant N secondes
FDM_FOLLOWUP_SECONDS=20
# Couper la parole à l'agent dès que quelqu'un parle
FDM_BARGE_IN=true

# Instructions supplémentaires (contexte de la réunion, rôle, etc.)
FDM_EXTRA_INSTRUCTIONS=
