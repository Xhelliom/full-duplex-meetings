# Clé API OpenAI (obligatoire)
OPENAI_API_KEY=sk-...

# Lien de la réunion à rejoindre (ou --join en ligne de commande)
FDM_JOIN=

# Qui il est
FDM_AGENT_NAME=Nova
FDM_VOICE=marin
FDM_LANGUAGE=français
# Son rôle et ses domaines : il intervient de lui-même quand la discussion les touche
FDM_EXPERTISE=
# À quel point il prend la parole spontanément : reserve | normal | active
FDM_PROACTIVITY=normal
# Ordre du jour, participants… (facultatif)
FDM_CONTEXT=

# Modèle : gpt-live-1 (passer à gpt-live-1.1 dès qu'il sera dans l'API)
FDM_MODEL=gpt-live-1
# Qui réfléchit quand il délègue : responses (modèle OpenAI + recherche web) | client
FDM_DELEGATION=responses
FDM_BACKEND_MODEL=gpt-5.6-luna

# Conteneur : 1 = écran du bot visible en VNC sur localhost:5900
FDM_VNC=1
